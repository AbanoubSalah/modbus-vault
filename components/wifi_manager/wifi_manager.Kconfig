menu "Network Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "SET_AT_BUILD_TIME"

    config WIFI_PASSWORD
        string "WiFi Password"
        default ""

    config WIFI_AUTH_THRESHOLD
        bool "Set minimum WiFi Security Threshold"
        default y
        help
            If enabled, the device will refuse to connect to networks 
            with security weaker than the selected level.

    config WIFI_AUTH_MODE
        int "Minimum Authentication Mode"
        depends on WIFI_AUTH_THRESHOLD
        default 3
        range 0 9
        help
            0: Open, 1: WEP, 2: WPA_PSK, 3: WPA2_PSK, 4: WPA_WPA2_PSK, 
            5: WPA2_ENTERPRISE, 6: WPA3_PSK, 7: WPA2_WPA3_PSK, 8: WAPI

endmenu